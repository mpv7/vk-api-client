{
    "name": "mpv7/vk-api-client",
    "description": "Typed, extensible and secure PHP 8.1+ client for the VK API methods messages.send, messages.getConversations and users.get.",
    "type": "library",
    "license": "MIT",
    "keywords": ["vk", "vkontakte", "api", "client", "messages", "sdk"],
    "homepage": "https://github.com/mpv7/vk-api-client",
    "authors": [
        {
            "name": "Mikhail Paseka",
            "homepage": "https://github.com/mpv7"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "ext-curl": "Required by the bundled CurlHttpClient (otherwise inject your own HttpClientInterface)"
    },
    "autoload": {
        "psr-4": {
            "Mpv7\\VkApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mpv7\\VkApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "check": [
            "@cs",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
